# ============================================================
# Online Shop - Root Environment Variables
# Copy ke .env: cp .env.example .env
# ============================================================

# Database
POSTGRES_DB=online_shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password_change_me
DB_PORT=5432

# Backend
JWT_SECRET=ganti-dengan-secret-yang-kuat-dan-panjang
JWT_EXPIRES_IN=7d
BACKEND_PORT=8080

# Frontend
FRONTEND_URL=http://localhost
FRONTEND_PORT=80
