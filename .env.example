# ============================================================
# Online Shop - Root Environment Variables
# Copy ke .env: cp .env.example .env
# ============================================================

# Database
POSTGRES_DB=online_shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password_change_me
DB_PORT=5432

# Backend
JWT_SECRET=ganti-dengan-secret-yang-kuat-min-32-karakter
JWT_EXPIRES_IN=7d
BACKEND_PORT=8080
BASE_URL=http://localhost:8080
APP_NAME=Online Shop

# Frontend
FRONTEND_URL=http://localhost
FRONTEND_PORT=80

# WhatsApp Bridge (opsional — integrasi wabridge / notify-bridge)
# WABRIDGE_URL=http://localhost:3000/api/send

# ============================================================
# Email / SMTP (opsional — hapus tanda # untuk mengaktifkan)
# ============================================================

# --- Gmail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=emailanda@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_FROM=emailanda@gmail.com

# --- Mailtrap (testing) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=<dari mailtrap>
# SMTP_PASSWORD=<dari mailtrap>
# EMAIL_FROM=noreply@example.com

# --- SMTP hosting (cPanel/Niagahoster/dll) ---
