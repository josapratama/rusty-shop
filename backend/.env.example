# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/online_shop

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this
JWT_EXPIRES_IN=7d

# Server
HOST=0.0.0.0
PORT=8080
BASE_URL=http://localhost:8080

# App
APP_NAME=Online Shop
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads

# WhatsApp Bridge (opsional — integrasi wabridge / notify-bridge)
# WABRIDGE_URL=http://localhost:3000/api/send

# ============================================================
# Email / SMTP (opsional — kalau tidak diisi, email dilewati)
